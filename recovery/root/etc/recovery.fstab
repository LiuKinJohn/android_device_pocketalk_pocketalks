/boot emmc /dev/block/by-name/boot flags=backup=1;flashimg=1
/recovery emmc /dev/block/by-name/recovery flags=backup=1;flashimg=1
/system ext4 /dev/block/by-name/system flags=display=System;backup=1;wipeingui
/vendor ext4 /dev/block/by-name/vendor flags=display=Vendor;backup=1;wipeingui
/cache ext4 /dev/block/by-name/cache flags=display=Cache;backup=1;wipeingui
/data ext4 /dev/block/by-name/userdata flags=display=Data;backup=1;wipeingui;encryptable=footer

# Optional removable storage entries. Confirm block paths on-device before release.
/external_sd vfat /dev/block/mmcblk1p1 flags=display=MicroSD;storage;wipeingui;removable
/usb_otg auto /dev/block/sda1 flags=display=USB-Storage;storage;wipeingui;removable
